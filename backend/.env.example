# SecureDesk backend configuration.
# Copy to .env and fill in. Every variable is declared in core/config.py.
# The app refuses to start on a missing, placeholder or weak secret.

# ── Runtime ─────────────────────────────────────────────────────────
# development | staging | production
# Must be "production" on Render — it gates exact-origin CORS, the
# localhost-Mongo check, and error-detail suppression.
ENVIRONMENT=development
LOG_LEVEL=INFO
EXPOSE_ERROR_DETAIL=false

# ── Database ────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=cybersec_db

# ── Auth ────────────────────────────────────────────────────────────
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters and ~96 bits of entropy, or the app will not boot.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── URLs / CORS ─────────────────────────────────────────────────────
# CORS_ORIGINS is an exact allowlist, comma-separated. Wildcards are
# rejected in production. Vercel preview deploys are therefore blocked —
# see README. Add chrome-extension://<id> when the extension ships.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=

# ── AI providers ────────────────────────────────────────────────────
# Optional. Absent keys are fine: the scan pipeline degrades to the local
# regex tier by design. Fallback order is fixed: Claude -> OpenAI -> regex.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Google Sign-In ─────────────────────────────────────────────────
# The OAuth 2.0 "Web application" client ID from Google Cloud. Not secret
# (it also ships in the frontend as VITE_GOOGLE_CLIENT_ID and MUST match),
# but the backend verifies every Google credential's audience against it.
# Empty disables POST /api/auth/google (503).
GOOGLE_CLIENT_ID=

# ── Email ───────────────────────────────────────────────────────────
# Password reset stays disabled until BOTH are set. The reset token is a
# bearer credential and is only ever delivered by email.
SMTP_EMAIL=
SMTP_PASSWORD=
MANAGER_ALERT_EMAIL=

# ── Evidence chain (Phase 3) ─────────────────────────────────────────
# EVIDENCE_ENABLED=true makes EVIDENCE_SIGNING_KEY mandatory in production.
# Generate a keypair with:
#   python -m scripts.generate_evidence_keypair
# The private key must go in a secret manager, never committed here.
EVIDENCE_ENABLED=false
EVIDENCE_SIGNING_KEY=
EVIDENCE_PUBLIC_KEY=

# ── Billing ─────────────────────────────────────────────────────────
# Deliberately unset: the billing router is unmounted in main.py.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
